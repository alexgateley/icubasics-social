<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Kicks the afternoon explainer short at 3:05 and 5:05 PM Chicago (1:05 and 3:05 PM Pacific). The
       workflow posts from 3 PM Chicago, only on dates in shorts-pm/<brand>/schedule.json, never twice.
       Install: cp launchd/com.icubasics.afternoon.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.icubasics.afternoon.plist -->
  <key>Label</key>
  <string>com.icubasics.afternoon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/alex/.gemini/antigravity-ide/scratch/icubasics-social/scripts/kick-post.sh</string>
    <string>afternoon</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>15</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alex/Library/Logs/icubasics-afternoon.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/Library/Logs/icubasics-afternoon.launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
